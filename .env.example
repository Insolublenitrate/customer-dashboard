# Postgres connection (Vercel Postgres/Neon integration injects this automatically in
# deployed environments; for local dev, copy the value from the Vercel dashboard).
POSTGRES_URL=

# better-auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The origin this app is served from, e.g. http://localhost:3000 locally
# or https://your-app.vercel.app in production.
BETTER_AUTH_URL=

# File storage for uploaded meeting minutes / emails (Vercel Blob).
BLOB_READ_WRITE_TOKEN=

# Claude API key, used to summarize communications and extract action items.
ANTHROPIC_API_KEY=
