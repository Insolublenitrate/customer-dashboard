# Committed, non-secret defaults (Next.js loads .env in every environment,
# with lowest precedence — a real DEMO_MODE set in Vercel's dashboard, or in
# a local .env.local, overrides this). Never put secrets in this file: it's
# committed to a public repo.

# Demo deployment: login wall is off so this can be shared without an
# account. Set to "false" (or remove this file) once real customer data
# goes in — see .env.example for what that requires.
DEMO_MODE=true
